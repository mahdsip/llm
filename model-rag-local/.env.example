# Local configuration. Copy to .env and adjust the values for your machine.
# NEVER commit .env to a public repository.

# Absolute path on the host containing the documents to index.
# Example only: /home/your-user/Documents
DOCUMENTS_DIR_HOST=/home/your-user/Documents

LLM_MODEL=llama3.1:8b
EMBEDDING_MODEL=nomic-embed-text
TOP_K=6
