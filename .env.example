# ============================================================
# myagent — Configuración de entorno
# Copia este archivo a .env y ajusta los valores.
# NUNCA subas .env a un repositorio público.
# ============================================================

# ---- Modelo activo ------------------------------------------------
# Modelo Ollama que usará el agente por defecto.
# Opciones predefinidas: qwen2.5-coder:14b | deepseek-r1:32b
MYAGENT_MODEL=qwen2.5-coder:14b

# ---- Ollama -------------------------------------------------------
# URL base del servidor Ollama. Ajústala si corres Ollama en otro host.
OLLAMA_HOST=http://localhost:11434

# ---- Backend RAG --------------------------------------------------
# Backend de almacenamiento vectorial: "faiss" (por defecto) o "qdrant"
RAG_BACKEND=faiss

# Directorio de documentos a indexar
RAG_DOCS_DIR=./docs

# ---- FAISS --------------------------------------------------------
# Directorio donde se persiste el índice FAISS
FAISS_INDEX_DIR=.rag_index/faiss

# ---- Qdrant (solo si RAG_BACKEND=qdrant) --------------------------
# URL del servidor Qdrant
QDRANT_URL=http://localhost:6333

# Nombre de la colección en Qdrant
QDRANT_COLLECTION=myagent_docs

# ---- Embeddings ---------------------------------------------------
# Modelo de embeddings disponible en Ollama
EMBEDDING_MODEL=nomic-embed-text
