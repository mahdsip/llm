# ============================================================
# myagent — Configuración de entorno
# Copia este archivo a .env y ajusta los valores.
# NUNCA subas .env a un repositorio público.
# ============================================================

# ---- Modelo activo ------------------------------------------------
# Modelo Ollama que usará el agente por defecto.
# Opciones predefinidas: qwen2.5-coder:14b | deepseek-r1:32b
MYAGENT_MODEL=qwen2.5-coder:14b

# ---- Ollama -------------------------------------------------------
# URL base del servidor Ollama. Ajústala si corres Ollama en otro host.
OLLAMA_HOST=http://localhost:11434

# ---- Flash Attention ----------------------------------------------
# Ollama activa Flash Attention automáticamente cuando el hardware lo
# soporta. Para forzarlo o desactivarlo:
#   OLLAMA_FLASH_ATTENTION=1   → forzar activación
#   OLLAMA_FLASH_ATTENTION=0   → desactivar (útil en hardware inestable)
# OLLAMA_FLASH_ATTENTION=1

# ---- Qdrant (backend RAG) -----------------------------------------
# Qdrant es el único backend RAG soportado. FAISS fue descartado porque
# requiere reconstruir el índice completo en cada cambio de documentos;
# Qdrant soporta upserts incrementales.

# URL del servidor Qdrant
QDRANT_URL=http://localhost:6333

# Nombre de la colección en Qdrant
QDRANT_COLLECTION=myagent_docs

# ---- Embeddings ---------------------------------------------------
# Modelo de embeddings servido por Ollama
EMBEDDING_MODEL=nomic-embed-text
